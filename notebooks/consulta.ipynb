   "source": [
    "import duckdb\n",
    "with duckdb.connect(\"../data/f1_market.duckdb\") as con:\n",
    "    con.sql(\"\"\"\n",
    "SELECT constructor, race_name, ticker, COUNT(*) \n",
    "FROM ticker_variation \n",
    "GROUP BY 1,2,3 \n",
    "HAVING COUNT(*) > 1\n",
    "\"\"\").show()\n"
   ]
  }
